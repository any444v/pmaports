# Forked from Alpine aports to retry opening the voice PCMs (xiaomi-tulip)
pkgname=q6voiced
pkgver=0.3.1
pkgrel=2
pkgdesc="Simple daemon that starts q6voice call audio on Qualcomm devices"
url="https://gitlab.postmarketos.org/postmarketOS/q6voiced"
arch="all"
license="MIT"
makedepends="alsa-lib-dev dbus-dev meson"
subpackages="$pkgname-openrc"
source="https://gitlab.postmarketos.org/postmarketOS/q6voiced/-/archive/$pkgver/q6voiced-$pkgver.tar.gz
	0001-retry-opening-the-PCMs-while-the-call-is-active.patch
	"
options="!check" # no tests

build() {
	abuild-meson -Dsystemd=disabled . output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}
