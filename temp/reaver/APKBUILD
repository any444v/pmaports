pkgname=reaver
pkgver=1.6.6
pkgrel=0
pkgdesc="WPS brute-force and offline Pixie Dust attack tool (reaver-wps-fork-t6x)"
url="https://github.com/t6x/reaver-wps-fork-t6x"
arch="aarch64"
license="GPL-2.0-or-later"
makedepends="libpcap-dev linux-headers"
source="$pkgname-$pkgver.tar.gz::https://github.com/t6x/reaver-wps-fork-t6x/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/reaver-wps-fork-t6x-$pkgver"
options="!check"

build() {
	cd "$builddir/src"
	./configure --prefix=/usr --sysconfdir=/etc --localstatedir=/var
	make
}

package() {
	cd "$builddir/src"
	make DESTDIR="$pkgdir" install
}

