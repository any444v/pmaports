# Forked from Alpine aports: speaker switching with UCM device-combination
# profiles (xiaomi-tulip, PipeWire)
pkgname=callaudiod
pkgver=0.1.99
pkgrel=2
pkgdesc="Daemon for dealing with audio routing during phone calls"
url="https://gitlab.com/mobian1/callaudiod"
arch="all"
license="GPL-3.0-or-later"
makedepends="alsa-lib-dev appstream-dev glib-dev meson pulseaudio-dev"
subpackages="$pkgname-dev $pkgname-libs"
source="https://gitlab.com/mobian1/callaudiod/-/archive/$pkgver/callaudiod-$pkgver.tar.gz
	0001-cad-pulse-switch-the-card-profile-to-enable-the-speaker.patch
	"
options="!check" # no tests

build() {
	abuild-meson . output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}
